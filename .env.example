# Custos environment — copy to .env (gitignored). NEVER commit real secrets.

# --- QVAC P2P (Orchestrator/M1 provider identity) ---
# Stable Hyperswarm identity seed for the provider's public key (C1).
QVAC_HYPERSWARM_SEED=

# --- WDK wallet (Edge/Intel only — keys live ONLY on Edge) ---
# Seed/mnemonic for the self-custodial WDK wallet. Held only on the Edge node.
CUSTOS_WALLET_SEED=

# --- Chain (testnet only — never mainnet) ---
# Ethereum Sepolia RPC (MEV-protected preferred); disclosed in evidence/remote_apis.json.
SEPOLIA_RPC_URL=
# Sepolia test USD₮ ERC-20 token address (pinned, not read from invoice).
SEPOLIA_USDT_ADDRESS=
