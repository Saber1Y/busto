# Busto environment — copy to .env (gitignored). NEVER commit real secrets.

# --- QVAC P2P (Orchestrator/M1 provider identity) ---
# Stable Hyperswarm identity seed for the provider's public key (C1).
QVAC_HYPERSWARM_SEED=

# --- Edge signer (keys live ONLY on the Edge node) ---
# 32-byte hex private key for the local viem signer. Held only on the Edge node.
# The Orchestrator has no key API surface.
BUSTO_WALLET_SEED=

# --- Network: BOT Chain Testnet (chain 968). Testnet only — never mainnet. ---
BOT_RPC_URL=https://rpc.bohr.life
BUSTO_CHAIN_ID=968
BUSTO_EXPLORER_URL=https://scan.bohr.life

# --- Payment asset: BOT Chain Testnet USDT (pinned, never read from an invoice) ---
# NOTE: an Ethereum USDT address is NOT valid on BOT Chain.
BUSTO_USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
BUSTO_USDT_DECIMALS=6

# --- Deployed settlement contract ---
BUSTO_SETTLEMENT_CONTRACT=0xf08790ceffd2521538f4be5cabad059631bd2eb2